{
  "name": "regua",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npm install expo && npx expo install react react-native expo-router expo-linking expo-constants expo-status-bar react-native-screens react-native-safe-area-context react-native-svg @react-native-async-storage/async-storage @expo/vector-icons expo-dev-client && npx expo install typescript @types/react -- --save-dev && npx expo install --fix",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts server/tests/*.test.ts",
    "test:db": "supabase/tests/run.sh",
    "test:e2e": "cd prototype && node build.mjs && python3 e2e.py && python3 e2e_edge.py"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-purchases": "^10.13.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "^5.1.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2",
    "esbuild": "^0.25.10",
    "pg": "^8.23.1",
    "typescript": "~5.9"
  }
