# Copy to .env.local and fill in. Never commit real values.
# --- Supabase (create the project yourself at supabase.com) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server only: Edge Functions and scripts. Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=
# --- FIPE data provider (fipe.api.br) ---
FIPE_API_TOKEN=
FIPE_REQUESTS_PER_RUN=400
# shared secret the scheduler sends to the ingest-fipe function
INGEST_CRON_SECRET=
# --- RevenueCat (in-app purchases) ---
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENVIRONMENT=SANDBOX
# app side (public SDK keys, safe in the app bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
