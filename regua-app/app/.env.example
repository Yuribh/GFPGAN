# Copy to .env.local and fill in. Never commit real values.
# In the cloud the same names go to EAS (eas env:create) or to GitHub (Settings > Secrets and variables > Actions).

# --- Supabase (create the project yourself at supabase.com) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# server only: Edge Functions and scripts. Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=
# --- FIPE data provider (fipe.api.br) ---
FIPE_API_TOKEN=
FIPE_REQUESTS_PER_RUN=400
# shared secret the scheduler sends to the ingest-fipe function
INGEST_CRON_SECRET=
# --- Plate lookup (Edge Function plate-lookup; server only, never in the app) ---
# provider URL with {plate}, e.g. https://api.provider.com/v1/placa/{plate}
PLATE_API_URL=
PLATE_API_TOKEN=
# how the token is sent: bearer | header:X-Api-Key | query:key
PLATE_API_AUTH=bearer
# long random secret; plates are stored only as HMAC(pepper, plate). Never change it after launch (the cache would miss).
PLATE_HASH_PEPPER=
# lookups per device per day, and paid provider calls per day for the whole app
PLATE_FREE_DAILY=3
PLATE_PLUS_DAILY=30
PLATE_GLOBAL_DAILY=300
# RevenueCat secret API key (Project settings > API keys > secret), so the server can check Plus itself
REVENUECAT_SECRET_KEY=
# --- RevenueCat (in-app purchases) ---
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENVIRONMENT=SANDBOX

# --- app side: public values, they end up inside the app ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys (Project settings > API keys). Empty = no Régua Plus in the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# AdMob banner unit ids. Empty = Google's test banner (earns nothing).
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
# Sentry DSN for crash reports. Empty = off.
EXPO_PUBLIC_SENTRY_DSN=
# shown in the About screen
EXPO_PUBLIC_SUPPORT_EMAIL=
# defaults to the GitHub Pages site; change if you host the pages elsewhere
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=

# --- build time only (read by app.config.js) ---
# AdMob app ids (AdMob > Apps > App settings). Empty = Google's sample ids.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# from `npx eas-cli init`
EAS_PROJECT_ID=
# optional: Sentry source map upload (also needs SENTRY_AUTH_TOKEN as a secret)
SENTRY_ORG=
SENTRY_PROJECT=
